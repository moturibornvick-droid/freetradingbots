<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <variables>
    <variable id="v_init">InitialStake</variable>
    <variable id="v_cur">CurrentStake</variable>
    <variable id="v_mg">MartingaleFactor</variable>
    <variable id="v_mgsteps">MGSteps</variable>
    <variable id="v_maxmg">MaxMG</variable>
    <variable id="v_tp">TakeProfit</variable>
    <variable id="v_sl">StopLoss</variable>
    <variable id="v_loss">LossStreak</variable>
    <variable id="v_time">DurationTicks</variable>
  </variables>

  <block type="trade" id="trade_demo" x="0" y="0">
    <field name="MARKET_LIST">synthetic_index</field>
    <field name="SUBMARKET_LIST">random_index</field>
    <field name="SYMBOL_LIST">R_100</field>
    <field name="TRADETYPECAT_LIST">digits</field>
    <field name="TRADETYPE_LIST">overunder</field>
    <field name="TYPE_LIST">DIGITDIFF</field>
    <field name="CANDLEINTERVAL_LIST">1</field>
    <field name="RESTARTONERROR">TRUE</field>

    <statement name="INITIALIZATION">
      <block type="variables_set">
        <field name="VAR" id="v_init">InitialStake</field>
        <value name="VALUE">
          <block type="math_number"><field name="NUM">0.35</field></block>
        </value>
        <next>
          <block type="variables_set">
            <field name="VAR" id="v_cur">CurrentStake</field>
            <value name="VALUE">
              <block type="variables_get"><field name="VAR" id="v_init">InitialStake</field></block>
            </value>
            <next>
              <block type="variables_set">
                <field name="VAR" id="v_mg">MartingaleFactor</field>
                <value name="VALUE"><block type="math_number"><field name="NUM">2.3</field></block></value>
                <next>
                  <block type="variables_set">
                    <field name="VAR" id="v_mgsteps">MGSteps</field>
                    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                    <next>
                      <block type="variables_set">
                        <field name="VAR" id="v_maxmg">MaxMG</field>
                        <value name="VALUE"><block type="math_number"><field name="NUM">5</field></block></value>
                        <next>
                          <block type="variables_set">
                            <field name="VAR" id="v_tp">TakeProfit</field>
                            <value name="VALUE"><block type="math_number"><field name="NUM">10</field></block></value>
                            <next>
                              <block type="variables_set">
                                <field name="VAR" id="v_sl">StopLoss</field>
                                <value name="VALUE"><block type="math_number"><field name="NUM">30</field></block></value>
                                <next>
                                  <block type="variables_set">
                                    <field name="VAR" id="v_loss">LossStreak</field>
                                    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                                    <next>
                                      <block type="variables_set">
                                        <field name="VAR" id="v_time">DurationTicks</field>
                                        <value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <statement name="SUBMARKET">
      <block type="tradeOptions">
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION"><block type="variables_get"><field name="VAR" id="v_time">DurationTicks</field></block></value>
        <value name="AMOUNT"><block type="variables_get"><field name="VAR" id="v_cur">CurrentStake</field></block></value>
        <value name="PREDICTION"><block type="text"><field name="TEXT">differs</field></block></value>
      </block>
    </statement>
  </block>

  <!-- BEFORE PURCHASE: DEMO behavior — log/notify instead of buying -->
  <block type="before_purchase" x="0" y="420">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="notify">
        <field name="NOTIFICATION_TYPE">info</field>
        <field name="NOTIFICATION_SOUND">silent</field>
        <value name="MESSAGE">
          <block type="text_join">
            <mutation items="3" />
            <value name="ADD0"><block type="text"><field name="TEXT">[DEMO] BUY SIGNAL — Contract: DIGITDIFF</field></block></value>
            <value name="ADD1"><block type="text"><field name="TEXT"> | Stake: </field></block></value>
            <value name="ADD2"><block type="variables_get"><field name="VAR" id="v_cur">CurrentStake</field></block></value>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <!-- AFTER PURCHASE: DEMO update flow — simulates win/loss logic using contract_check_result but DOES NOT buy -->
  <block type="after_purchase" x="0" y="720">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result"><field name="CHECK_RESULT">win</field></block>
        </value>
        <statement name="DO0">
          <block type="variables_set"><field name="VAR" id="v_cur">CurrentStake</field>
            <value name="VALUE"><block type="variables_get"><field name="VAR" id="v_init">InitialStake</field></block></value>
            <next>
              <block type="variables_set"><field name="VAR" id="v_mgsteps">MGSteps</field>
                <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                <next>
                  <block type="variables_set"><field name="VAR" id="v_loss">LossStreak</field>
                    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                    <next>
                      <block type="notify">
                        <field name="NOTIFICATION_TYPE">success</field>
                        <field name="NOTIFICATION_SOUND">silent</field>
                        <value name="MESSAGE"><block type="text_join"><mutation items="2"/><value name="ADD0"><block type="text"><field name="TEXT">[DEMO] WIN — TotalProfit: </field></block></value><value name="ADD1"><block type="total_profit"/></value></block></value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>

        <statement name="ELSE">
          <block type="notify">
            <field name="NOTIFICATION_TYPE">warn</field>
            <field name="NOTIFICATION_SOUND">silent</field>
            <value name="MESSAGE"><block type="text_join"><mutation items="2"/><value name="ADD0"><block type="text"><field name="TEXT">[DEMO] LOSS — TotalProfit: </field></block></value><value name="ADD1"><block type="total_profit"/></value></block></value>
            <next>
              <block type="math_change"><field name="VAR" id="v_loss">LossStreak</field><value name="DELTA"><block type="math_number"><field name="NUM">1</field></block></value>
                <next>
                  <block type="math_change"><field name="VAR" id="v_mgsteps">MGSteps</field><value name="DELTA"><block type="math_number"><field name="NUM">1</field></block></value>
                    <next>
                      <block type="controls_if">
                        <mutation else="1"></mutation>
                        <value name="IF0">
                          <block type="logic_compare"><field name="OP">LTE</field><value name="A"><block type="variables_get"><field name="VAR" id="v_mgsteps"/></block></value><value name="B"><block type="variables_get"><field name="VAR" id="v_maxmg"/></block></value></block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set"><field name="VAR" id="v_cur">CurrentStake</field>
                            <value name="VALUE"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get"><field name="VAR" id="v_cur"/></block></value><value name="B"><block type="variables_get"><field name="VAR" id="v_mg"/></block></value></block></value>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <block type="notify"><field name="NOTIFICATION_TYPE">error</field><field name="NOTIFICATION_SOUND">silent</field><value name="MESSAGE"><block type="text"><field name="TEXT">[DEMO] Max martingale reached — stopping demo.</field></block></value><next><block type="stop"/></next></block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>

        <next>
          <block type="controls_if">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block type="logic_operation"><field name="OP">OR</field>
                <value name="A"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="total_profit"/></value><value name="B"><block type="variables_get"><field name="VAR" id="v_tp"/></block></value></block></value>
                <value name="B"><block type="logic_compare"><field name="OP">LTE</field><value name="A"><block type="total_profit"/></value><value name="B"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get"><field name="VAR" id="v_sl"/></block></value><value name="B"><block type="math_number"><field name="NUM">-1</field></block></value></block></value></block></value>
              </block>
            </value>
            <statement name="DO0">
              <block type="notify"><field name="NOTIFICATION_TYPE">info</field><field name="NOTIFICATION_SOUND">silent</field><value name="MESSAGE"><block type="text_join"><mutation items="2"/><value name="ADD0"><block type="text"><field name="TEXT">[DEMO] Target reached — stopping. TotalProfit: </field></block></value><value name="ADD1"><block type="total_profit"/></value></block></value><next><block type="stop"/></next></block>
            </statement>
            <statement name="ELSE">
              <block type="trade_again"/>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>

                                    
